# MySQL (docker-compose.yml 기본값과 일치)
# allowPublicKeyRetrieval=true — MySQL 8 기본 인증(caching_sha2_password)에서
# 클라이언트가 서버 RSA 공개키를 못 받아와 "pool timeout" 으로 죽는 문제 방지
DATABASE_URL="mysql://planlog:planlog@localhost:3306/planlog?allowPublicKeyRetrieval=true"

# 한국관광공사 TourAPI — data.go.kr 에서 아래 서비스들을 활용신청 후 발급받은
# "일반 인증키(Encoding)"를 그대로 넣는다 (계정당 1개, 모든 서비스 공유).
#   - 국문 관광정보 서비스 (KorService2)
#   - 관광지별 연관 관광지 정보 (TarRlteTarService1)
#   - 관광지 집중률·방문자 추이 (DataLabService)
#   - 반려동물 동반여행 서비스 (KorPetTourService2)
#   - 고캠핑 정보 조회서비스 (GoCamping)
# 발급 가이드: docs/ROADMAP.md 6장
TOUR_API_KEY="여기에_발급받은_Encoding_인증키"
TOUR_API_BASE_URL="https://apis.data.go.kr/B551011"
TOUR_API_APP_NAME="PLANLOG"

# 인증 — 운영 배포 전 반드시 교체
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"

PORT=9000
