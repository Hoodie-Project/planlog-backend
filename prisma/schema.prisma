// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // NestJS 빌드(CommonJS)와 맞추기 위해 CJS로 생성한다. (기본값은 ESM)
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// 인증 제공자
enum AuthProvider {
  KAKAO
  GUEST
}

/// 사용자 (카카오 로그인 + 게스트 계정)
model User {
  id           String       @id @default(cuid())
  provider     AuthProvider
  /// 카카오 회원번호. 게스트는 null
  providerId   String?
  nickname     String
  email        String?
  profileImage String?
  isGuest      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  savedCourses         SavedCourse[]
  bookmarks            Bookmark[]
  stamps               Stamp[]
  matchOptIns          MatchOptIn[]
  notificationSettings NotificationSettings?
  courseFeedbacks      CourseFeedback[]
  travelRecords        TravelRecord[]

  // 같은 제공자 내에서 providerId 중복 방지 (MySQL은 NULL 다중 허용 → 게스트 무제한)
  @@unique([provider, providerId])
}

/// 찜 대상 유형
enum BookmarkType {
  FESTIVAL // 축제 (TourAPI contentId)
  SPOT // 관광지 (TourAPI contentId)
  COURSE // 저장한 코스 (SavedCourse.id)
}

/// 저장한 코스 — 생성된 CourseDto 스냅샷을 JSON으로 보관
model SavedCourse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  zone      String
  nights    Int      @default(0)
  /// 여행 날짜(선택). "다가오는 여행" D-Day 표시에 사용(상태 계산엔 미사용 — "코스 시작하기" 버튼이 기준)
  travelDate DateTime?
  /// "코스 시작하기" 버튼을 누른 시각(선택). 있으면 진행중으로 간주.
  startedAt DateTime?
  /// 리뷰/스탬프 여부와 무관하게 유저가 직접 "완료" 처리한 시각(선택). 있으면 완료로 간주.
  completedAt DateTime?
  /// 생성 당시 CourseDto 전체 (관광 원본은 contentId 참조이므로 스냅샷 보관 OK)
  payload   Json
  createdAt DateTime @default(now())

  travelRecords TravelRecord[]

  @@index([userId])
}

/// 찜 (축제·관광지·코스)
model Bookmark {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType BookmarkType
  /// FESTIVAL/SPOT=TourAPI contentId, COURSE=SavedCourse.id
  targetId   String
  title      String
  image      String?
  /// 축제 시작일 등 D-Day 알림 기준일
  dDayDate   DateTime?
  createdAt  DateTime     @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

/// 감성 스탬프 — 코스 내 관광지 실제 방문 인증 (감성존별 도장)
model Stamp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 감성존 (SEA/SNOW/VALLEY/RETRO/PHOTO)
  zone      String
  contentId String
  title     String
  image     String?
  visitedAt DateTime @default(now())

  travelRecords TravelRecord[]

  // 같은 관광지는 한 번만 스탬프
  @@unique([userId, contentId])
  @@index([userId])
}

/// 동선 매칭 옵트인 — 동일 감성존·날짜 여행 메이트 매칭(상호 옵트인)
model MatchOptIn {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone       String
  travelDate DateTime
  createdAt  DateTime @default(now())

  @@unique([userId, zone, travelDate])
  @@index([zone, travelDate])
}

/// 알림 설정 (마이페이지) — 유저당 1개, 최초 조회 시 기본값으로 생성
model NotificationSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ddayAlert      Boolean  @default(true)
  festivalAlert  Boolean  @default(true)
  courseReminder Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

/// 코스 결과 피드백 — 프리셋 선택지(courseFeedbackOptions) 기반 개선 요청 로그
model CourseFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone      String
  /// 선택한 프리셋 문구 배열(JSON), 예: ["더 여유로운 코스로", "걷는 시간 줄이기"]
  options   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

/// 여행 기록 카드 — 다녀온 여행에 대해 유저가 직접 남기는 짧은 기록(저널)
model TravelRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  travelDate DateTime
  /// 방문 지역(예: "강릉")
  location   String
  /// 감성존 (SEA/SNOW/VALLEY/RETRO/PHOTO) — 리뷰 작성 시점의 코스 감성존
  zone       String
  /// 한 줄 소감
  note       String
  /// 오늘의 감정 — 고정 8종 중 1개(Mood enum, class-validator로 검증. DB 컬럼 자체는 String). 선택
  mood       String?
  image      String?
  /// 태그 문자열 배열(JSON), 예: ["바다", "혼자", "카페"]
  tags       Json
  createdAt  DateTime @default(now())

  /// 이 기록의 근거가 된 저장 코스(선택) — 코스가 나중에 삭제돼도 기록은 남도록 SetNull
  savedCourseId String?
  savedCourse   SavedCourse? @relation(fields: [savedCourseId], references: [id], onDelete: SetNull)

  /// savedCourse 생성 시점 CourseDto 스냅샷에서 뽑아온 요약 통계(방문 장소 수/총 이동거리/박수).
  /// savedCourse가 나중에 삭제돼도 화면에 표시할 값이 남도록 기록 생성 시 값을 복사해 저장한다.
  spotCount     Int?
  /// 총 이동 거리(m)
  totalDistance Int?
  nights        Int?

  /// 이 기록에서 획득한 것으로 표시할 스탬프들
  stamps Stamp[]

  @@index([userId])
  @@index([savedCourseId])
}
